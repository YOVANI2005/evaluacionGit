@startuml Arquitectura_EPS

title Arquitectura de Microservicios - EPS

skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12

skinparam component {
  BackgroundColor<<gateway>> #FDEBD0
  BackgroundColor<<service>> #D5F5E3
  BackgroundColor<<bus>> #FCF3CF
  BorderColor #2C3E50
  FontColor #2C3E50
}

skinparam database {
  BackgroundColor #EAEDED
  BorderColor #7F8C8D
  FontColor #333333
}

actor "Clientes\n(Portal Web / App Móvil)" as Clientes

component "API Gateway\n(enrutamiento, auth, rate-limit)" as Gateway <<gateway>>

package "Microservicios EPS" {
  component "ms-autenticacion\n(login, roles, JWT)" as Auth <<service>>
  component "ms-afiliados\n(registro, EPS-usuario)" as Afiliados <<service>>
  component "ms-citas-medicas\n(agenda, disponibilidad)" as Citas <<service>>
  component "ms-historia-clinica\n(diagnósticos, evolución)" as Historia <<service>>
  component "ms-autorizaciones\n(procedimientos, remisiones)" as Autorizaciones <<service>>
  component "ms-facturacion\n(pagos, copagos, cuotas)" as Facturacion <<service>>
  component "ms-farmacia\n(dispensación medicamentos)" as Farmacia <<service>>
  component "ms-notificaciones\n(email, SMS, push)" as Notificaciones <<service>>
}

component "Bus de Mensajería\n(eventos asíncronos)" as Bus <<bus>>

database "BD Autenticación" as DBAuth
database "BD Afiliados" as DBAfil
database "BD Citas" as DBCitas
database "BD Historia Clínica" as DBHist
database "BD Autorizaciones" as DBAut
database "BD Facturación" as DBFact
database "BD Farmacia" as DBFarm

Clientes --> Gateway

Gateway --> Auth
Gateway --> Afiliados
Gateway --> Citas
Gateway --> Historia
Gateway --> Autorizaciones
Gateway --> Facturacion
Gateway --> Farmacia

Auth --> DBAuth
Afiliados --> DBAfil
Citas --> DBCitas
Historia --> DBHist
Autorizaciones --> DBAut
Facturacion --> DBFact
Farmacia --> DBFarm

Citas ..> Bus : eventos
Autorizaciones ..> Bus : eventos
Facturacion ..> Bus : eventos
Bus ..> Notificaciones : consume eventos

@enduml
